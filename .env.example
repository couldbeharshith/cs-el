# Web app and shared provider credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME="Sampada AI"
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# GOOGLE_GENERATIVE_AI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_API_KEY=
# EXA_API_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional database-query tool with an existing execute_sql RPC
# SUPABASE_ADMIN=

# Local integrations. Set an MCP URL to an empty value to disable it.
# RAG_MCP_URL=http://127.0.0.1:8001/mcp
# COMPUTER_MCP_URL=http://127.0.0.1:8002/mcp
# SCREENER_API_URL=http://127.0.0.1:8080
# MCP_SERVER_PORT=8001
# COMPUTER_MCP_PORT=8002

# Insurance worker, gateway, and document MCP share this bearer token
# RAG_API_KEY=
# RAG_SERVER_URL=http://localhost:7860/api/v1/hackrx/run
RAG_WORKER_HOST=127.0.0.1
# RAG_WORKER_PORT=7860
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=insurance-rag
# PINECONE_HOST_URL=
# GEMINI_API_KEY=
# GROQ_API_KEY above also works for the insurance worker.
# Add numbered keys for rotation using GEMINI_API_KEY_1 through _25 and
# GROQ_API_KEY_1 through _15. A numbered key _1 takes priority over its unnumbered key.
# PINECONE_RERANKING_ENABLED=false
# Optional reranker pools use PINECONE_RERANKER_API_KEY_1 through _11
# and COHERE_API_KEY_1 through _13.

# Screener API
# SCREENER_EMAIL=
# SCREENER_PASSWORD=
# GOOGLE_API_KEY=
# SCREENER_CHROME_MAJOR=

# Optional backend retrieval and document processing
# ENVIRONMENT=development
# DEFAULT_VECTOR_STORE=supabase
# EMBEDDING_MODEL=text-embedding-3-small
# DEFAULT_LLM_PROVIDER=openai
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# SUPABASE_TABLE_NAME=documents
# SUPABASE_QUERY_NAME=match_documents
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
